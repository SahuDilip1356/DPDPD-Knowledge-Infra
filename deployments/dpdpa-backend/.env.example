# Runtime mode
APP_ENV=development

# Canonical database and Supabase service access
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Model providers (server-side secrets; configure at least one in production)
# GPT-OSS is the grounded cook: retrieval over the knowledge graph, no weight training.
REASONING_PROVIDER=
GPT_OSS_BASE_URL=
GPT_OSS_MODEL=
GPT_OSS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CHAT_MODEL=
EMBED_MODEL=

# Retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dpdpa-knowledge

# Transitional admin authentication. Use 32+ random characters.
ADMIN_API_KEY=

# Browser origins and reverse-proxy handling
ALLOWED_ORIGINS=https://dpdpa.wiki,https://www.dpdpa.wiki
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
TRUST_PROXY_HEADERS=1

# Initial abuse controls
QUERY_MAX_CHARS=4000
QUERY_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_DAY=100
