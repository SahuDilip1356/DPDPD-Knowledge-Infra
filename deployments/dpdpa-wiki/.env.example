# dpdpa.wiki — Knowledge Infrastructure frontend (Vite)
# Copy this file to .env and fill in the values.
#
# Every VITE_* value is inlined into the client bundle at build time and is
# therefore PUBLIC. Never put a service key or any server-side secret here —
# the Supabase anon key is safe by design, the service key is not.

# ── Supabase (shared with dpdpa.shiksha) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── FastAPI backend gateway ───────────────────────────────────────────
# Local dev leaves this unset and falls back to http://localhost:8000.
# In production, point it at the deployed backend (Render / Railway / Cloud Run).
VITE_API_URL=https://api.dpdpa.wiki

# ── Cross-domain hand-off ─────────────────────────────────────────────
# Where /course sends the user. Defaults to https://dpdpa.shiksha.
VITE_SHIKSHA_URL=https://dpdpa.shiksha
